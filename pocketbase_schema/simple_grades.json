{
  "name": "grades",
  "type": "base",
  "schema": [
    {
      "name": "studentId",
      "type": "relation",
      "required": true,
      "options": {
        "collectionId": "students",
        "maxSelect": 1
      }
    },
    {
      "name": "assessmentId",
      "type": "relation",
      "required": true,
      "options": {
        "collectionId": "assessments",
        "maxSelect": 1
      }
    },
    {
      "name": "marksObtained",
      "type": "number",
      "required": true,
      "options": {
        "min": 0
      }
    },
    {
      "name": "totalMarks",
      "type": "number",
      "required": true,
      "options": {
        "min": 1
      }
    },
    {
      "name": "percentage",
      "type": "number",
      "required": false,
      "options": {
        "min": 0,
        "max": 100
      }
    },
    {
      "name": "grade",
      "type": "select",
      "required": false,
      "options": {
        "maxSelect": 1,
        "values": ["A", "B", "C", "D", "F"]
      }
    }
  ]
}