{
  "name": "courses",
  "type": "base",
  "schema": [
    {
      "name": "courseCode",
      "type": "text",
      "required": true,
      "options": {
        "min": 6,
        "max": 6,
        "pattern": "^[A-Z]{3}[0-9]{3}$"
      }
    },
    {
      "name": "courseName",
      "type": "text",
      "required": true,
      "options": {
        "min": 3,
        "max": 100
      }
    },
    {
      "name": "description",
      "type": "text",
      "required": true,
      "options": {
        "max": 500
      }
    },
    {
      "name": "credits",
      "type": "number",
      "required": true,
      "options": {
        "min": 1,
        "max": 6
      }
    },
    {
      "name": "status",
      "type": "select",
      "required": true,
      "options": {
        "maxSelect": 1,
        "values": ["active", "inactive"]
      }
    }
  ]
}