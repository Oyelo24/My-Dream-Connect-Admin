{
  "name": "students",
  "type": "base",
  "schema": [
    {
      "name": "studentId",
      "type": "text",
      "required": true,
      "options": {
        "min": 9,
        "max": 9,
        "pattern": "^STU[0-9]{6}$"
      }
    },
    {
      "name": "firstName",
      "type": "text",
      "required": true,
      "options": {
        "min": 2,
        "max": 50
      }
    },
    {
      "name": "lastName",
      "type": "text", 
      "required": true,
      "options": {
        "min": 2,
        "max": 50
      }
    },
    {
      "name": "email",
      "type": "email",
      "required": true
    },
    {
      "name": "phone",
      "type": "text",
      "required": true,
      "options": {
        "min": 10,
        "max": 15
      }
    },
    {
      "name": "status",
      "type": "select",
      "required": true,
      "options": {
        "maxSelect": 1,
        "values": ["active", "inactive", "graduated"]
      }
    }
  ]
}