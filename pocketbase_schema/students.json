{
  "name": "students",
  "type": "base",
  "schema": [
    {
      "name": "userId",
      "type": "relation",
      "required": true,
      "options": {
        "collectionId": "users",
        "cascadeDelete": true,
        "maxSelect": 1,
        "displayFields": ["firstName", "lastName", "email"]
      }
    },
    {
      "id": "studentId",
      "name": "studentId",
      "type": "text",
      "system": false,
      "required": true,
      "options": {
        "min": 9,
        "max": 9,
        "pattern": "^STU[0-9]{6}$"
      }
    },
    {
      "id": "firstName",
      "name": "firstName",
      "type": "text",
      "system": false,
      "required": true,
      "options": {
        "min": 2,
        "max": 50,
        "pattern": ""
      }
    },
    {
      "id": "lastName",
      "name": "lastName",
      "type": "text",
      "system": false,
      "required": true,
      "options": {
        "min": 2,
        "max": 50,
        "pattern": ""
      }
    },
    {
      "id": "email",
      "name": "email",
      "type": "email",
      "system": false,
      "required": true,
      "options": {
        "exceptDomains": null,
        "onlyDomains": null
      }
    },
    {
      "id": "phone",
      "name": "phone",
      "type": "text",
      "system": false,
      "required": true,
      "options": {
        "min": 10,
        "max": 15,
        "pattern": "^[+]?[0-9]{10,15}$"
      }
    },
    {
      "id": "dateOfBirth",
      "name": "dateOfBirth",
      "type": "date",
      "system": false,
      "required": true,
      "options": {
        "min": "",
        "max": ""
      }
    },
    {
      "id": "address",
      "name": "address",
      "type": "text",
      "system": false,
      "required": true,
      "options": {
        "min": 10,
        "max": 200,
        "pattern": ""
      }
    },
    {
      "id": "enrollmentDate",
      "name": "enrollmentDate",
      "type": "date",
      "system": false,
      "required": true,
      "options": {
        "min": "",
        "max": ""
      }
    },
    {
      "id": "status",
      "name": "status",
      "type": "select",
      "system": false,
      "required": true,
      "options": {
        "maxSelect": 1,
        "values": ["active", "inactive", "graduated"]
      }
    },
    {
      "id": "profileImage",
      "name": "profileImage",
      "type": "file",
      "system": false,
      "required": false,
      "options": {
        "maxSelect": 1,
        "maxSize": 5242880,
        "mimeTypes": ["image/jpeg", "image/png", "image/webp"],
        "thumbs": ["100x100"]
      }
    }
  ],
  "indexes": [
    "CREATE UNIQUE INDEX idx_students_studentId ON students (studentId)",
    "CREATE UNIQUE INDEX idx_students_userId ON students (userId)",
    "CREATE UNIQUE INDEX idx_students_email ON students (email)",
    "CREATE INDEX idx_students_status ON students (status)"
  ],
  "listRule": "@request.auth.id != '' && (@request.auth.role = 'admin' || userId = @request.auth.id)",
  "viewRule": "@request.auth.id != '' && (@request.auth.role = 'admin' || userId = @request.auth.id)",
  "createRule": "@request.auth.role = 'admin'",
  "updateRule": "@request.auth.role = 'admin'",
  "deleteRule": "@request.auth.role = 'admin'"
}